# NLP Service - Python 3.12
FROM python:3.12-slim

# Increase pip timeout for slow networks
ENV PIP_DEFAULT_TIMEOUT=200
ENV PIP_RETRIES=5

WORKDIR /app

# Copy certificates directory (may be empty or contain corporate certs like Zscaler)
COPY certs/ /tmp/certs/

# Install corporate certificates BEFORE any other apt-get operations
RUN apt-get update && apt-get install -y ca-certificates apt-transport-https && \
    if ls /tmp/certs/*.crt 1> /dev/null 2>&1; then \
        cp /tmp/certs/*.crt /usr/local/share/ca-certificates/ && \
        update-ca-certificates && \
        echo "✓ Corporate certificates installed"; \
    else \
        echo "ℹ No corporate certificates found (optional - only needed for Zscaler/corporate firewalls)"; \
    fi && \
    rm -rf /tmp/certs && \
    rm -rf /var/lib/apt/lists/*

# Configure Python/Node to use system certificates
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Install system dependencies for Chromium and Playwright
RUN apt-get update && apt-get install -y \
    chromium \
    chromium-driver \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libnss3 \
    libxss1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libnspr4 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Set Chrome path for Selenium
ENV CHROME_BIN=/usr/bin/chromium
ENV CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Copy requirements first (better layer caching)
COPY requirements-nlp.txt .

# Install PyTorch (CPU version) first to avoid conflicts
# Use >=2.3 for compatibility, let pip find the latest available version for the platform
RUN pip install --no-cache-dir "torch>=2.3" --index-url https://download.pytorch.org/whl/cpu

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-nlp.txt

# Install Playwright browsers (after pip install)
RUN playwright install chromium --with-deps

# Copy all required Python files
COPY url_fetch.py .
COPY service_nlp.py .
COPY nlp_processor.py .
COPY nlp.py .
COPY topics.py .
COPY adapters.py .
COPY fetch.py .
COPY render.py .
COPY apputils.py .
COPY excel_utils.py .
COPY file_store.py .

# Create temp directory
RUN mkdir -p /app/temp

# Pre-download HuggingFace models during build (avoids runtime download issues with corporate firewalls)
# This caches models in /root/.cache/huggingface/ inside the image
ENV HF_HUB_DISABLE_SSL_VERIFY=1

# Download all NLP models used by the service
RUN python -c "\
import ssl; \
ssl._create_default_https_context = ssl._create_unverified_context; \
import os; \
os.environ['CURL_CA_BUNDLE'] = ''; \
os.environ['REQUESTS_CA_BUNDLE'] = ''; \
from transformers import AutoTokenizer, AutoModelForSequenceClassification; \
models = [ \
    'cardiffnlp/twitter-roberta-base-sentiment-latest', \
    'distilbert-base-uncased-finetuned-sst-2-english', \
    'facebook/bart-large-mnli', \
    'MoritzLaurer/mDeBERTa-v3-base-mnli-xnli', \
    'MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli', \
    'MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli', \
]; \
for model in models: \
    print(f'Downloading {model}...'); \
    AutoTokenizer.from_pretrained(model); \
    AutoModelForSequenceClassification.from_pretrained(model); \
print('All models downloaded successfully!')"

# Expose port
EXPOSE 8001

# Health check (every 10 minutes)
HEALTHCHECK --interval=600s --timeout=10s --start-period=60s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8001/health').raise_for_status()"

# Run the NLP service
CMD ["python", "service_nlp.py"]
