# syntax=docker/dockerfile:1.7
# LEGACY: GPU-accelerated monolithic image (use docker-compose.gpu.yml instead)
# Using RAPIDS 24.08a with CUDA 12.5, Python 3.11 (Ubuntu 24.04)
# Note: rapidsai/rapidsai was replaced by rapidsai/base in RAPIDS 23.08+
# CUDA 12.5+ images use Ubuntu 24.04, CUDA 12.2 and below use Ubuntu 22.04
FROM rapidsai/base:24.08a-cuda12.5-py3.11

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/root/.cache/huggingface \
    TRANSFORMERS_NO_ADVISORY_WARNINGS=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    CUDA_VISIBLE_DEVICES=0

# Activate conda environment for all subsequent commands
SHELL ["/bin/bash", "-c"]

# System deps (curl for healthcheck; playwright will bring its own libs in install step)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      curl ca-certificates git \
      build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# --- Python deps ---
# RAPIDS base already has cudf and cugraph installed in the base conda environment
# Install remaining dependencies into the base environment
COPY req.txt /app/req.txt
RUN source /opt/conda/etc/profile.d/conda.sh && \
    conda activate base && \
    python -m pip install --upgrade pip && \
    pip install -r /app/req.txt

# --- CUDA Availability Check ---
# Verify CUDA is available (version agnostic)
RUN source /opt/conda/etc/profile.d/conda.sh && \
    conda activate base && \
    python - <<'PY'
import sys

print("=" * 60)
print("CUDA Environment Check")
print("=" * 60)

# Check nvidia-smi
try:
    import subprocess
    result = subprocess.run(['nvidia-smi'], capture_output=True, text=True)
    if result.returncode == 0:
        print("✓ nvidia-smi available")
        # Print GPU info
        for line in result.stdout.split('\n')[:15]:  # First 15 lines
            if line.strip():
                print(f"  {line}")
    else:
        print("⚠ nvidia-smi not found (build-time check, OK if building without GPU)")
except Exception as e:
    print(f"⚠ nvidia-smi check failed: {e}")
    print("  Note: This is OK during build. GPU will be detected at runtime.")

# Check PyTorch CUDA
try:
    import torch
    cuda_available = torch.cuda.is_available()
    if cuda_available:
        print(f"✓ PyTorch CUDA available")
        print(f"  CUDA version: {torch.version.cuda}")
        print(f"  Device count: {torch.cuda.device_count()}")
        if torch.cuda.device_count() > 0:
            print(f"  Device 0: {torch.cuda.get_device_name(0)}")
    else:
        print("⚠ PyTorch CUDA not available at build time")
        print("  Note: GPU will be detected when container runs with --gpus flag")
except Exception as e:
    print(f"⚠ PyTorch CUDA check failed: {e}")

# Check cuGraph
try:
    import cudf
    import cugraph
    print(f"✓ cuGraph available (version {cugraph.__version__})")
    print(f"✓ cuDF available (version {cudf.__version__})")
except Exception as e:
    print(f"✗ cuGraph/cuDF not available: {e}")
    sys.exit(1)

print("=" * 60)
print("Build complete. GPU will be available at runtime with --gpus flag")
print("=" * 60)
PY

# --- Optional browsers (Playwright) ---
# If you won't use URL rendering, you can comment this out to slim the image.
# This installs Chromium and its system dependencies inside the image.
RUN source /opt/conda/etc/profile.d/conda.sh && \
    conda activate base && \
    playwright install --with-deps chromium || true

# --- NLTK corpora (stopwords + punkt) ---
RUN source /opt/conda/etc/profile.d/conda.sh && \
    conda activate base && \
    python - <<'PY'
import nltk
nltk.download('stopwords', quiet=True)
try: nltk.download('punkt', quiet=True)
except Exception: pass
try: nltk.download('punkt_tab', quiet=True)
except Exception: pass
PY

# --- spaCy English model (CPU-friendly) ---
RUN source /opt/conda/etc/profile.d/conda.sh && \
    conda activate base && \
    python -m spacy download en_core_web_sm

# --- (Optional) Pre-warm Stanza English pipeline to avoid first-run download ---
RUN source /opt/conda/etc/profile.d/conda.sh && \
    conda activate base && \
    python - <<'PY'
try:
    import stanza
    stanza.download('en', processors='tokenize,pos,lemma,depparse', verbose=False)
except Exception:
    pass
PY

# App code
COPY . /app

# Port & runtime env
EXPOSE 8080
ENV HOST=0.0.0.0 \
    PORT=8080

# Simple healthcheck against FastAPI /healthz
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=5 \
  CMD curl -fsS http://127.0.0.1:${PORT}/healthz || exit 1

# Run the API with conda environment activated
CMD ["/bin/bash", "-c", "source /opt/conda/etc/profile.d/conda.sh && conda activate base && uvicorn app:app --host 0.0.0.0 --port 8080 --lifespan on"]
