FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Base OS deps + Chromium & Chromedriver for Selenium
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget git build-essential ca-certificates \
    chromium chromium-driver \
    libglib2.0-0 libnss3 libx11-6 libxcomposite1 libxrandr2 libxi6 \
    libatk1.0-0 libatk-bridge2.0-0 libxdamage1 libgbm1 libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY req.txt /app/req.txt

# Python deps
RUN pip install --upgrade pip && pip install -r /app/req.txt

# Playwright Chromium (primary renderer)
RUN python -m playwright install --with-deps chromium

# NLTK corpora (stopwords + punkt)
RUN python - <<'PY'
import nltk
nltk.download('stopwords', quiet=True)
try: nltk.download('punkt', quiet=True)
except Exception: pass
try: nltk.download('punkt_tab', quiet=True)
except Exception: pass
PY

# App
COPY . /app

EXPOSE 8080
ENV HOST=0.0.0.0 PORT=8080 \
    RENDER_BACKENDS=playwright,selenium \
    SELENIUM_ENGINE=chrome

CMD ["uvicorn","app:app","--host","0.0.0.0","--port","8080","--lifespan","on"]
