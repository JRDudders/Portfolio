# ---------- base ----------
FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# System deps (build tools minimal; playwright will add its own runtime deps)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git \
 && rm -rf /var/lib/apt/lists/*

# ---------- deps ----------
COPY req.txt /app/req.txt
RUN python -m pip install --upgrade pip \
 && pip install --no-cache-dir -r /app/req.txt

# Install Chromium + required OS deps for Playwright (one line is easiest)
RUN python -m playwright install --with-deps chromium

# ---------- app ----------
COPY app.py index.html nlp.py fetch.py render.py adapters.py apputils.py /app/

EXPOSE 8080

# Use a single worker; reload off in container; lifespan on (for graceful shutdown)
CMD ["python","-m","uvicorn","app:app","--host","0.0.0.0","--port","8080","--lifespan","on","--workers","1"]
