# Dockerfile.cpu
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# System libs (ffmpeg for ASR, git for model downloads with LFS pointers)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY req.txt /app/
RUN pip install --no-cache-dir -r req.txt

COPY app.py /app/

# Defaults (overridable at runtime)
ENV MODEL_ID=cardiffnlp/twitter-roberta-base-sentiment-latest \
    TASK=text-classification \
    DEVICE_MAP=auto \
    DTYPE=auto \
    PIPELINE_KWARGS='{"truncation": true, "padding": true, "return_all_scores": true}'

EXPOSE 8080
CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080"]

