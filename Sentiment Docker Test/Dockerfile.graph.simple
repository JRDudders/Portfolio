# Graph Analytics Service - Python 3.12 (Simplified for build issues)
FROM python:3.12-slim

WORKDIR /app

# Copy certificates directory (may be empty or contain corporate certs)
COPY certs /tmp/certs

# Install corporate certificates BEFORE any other operations
RUN apt-get update && apt-get install -y ca-certificates apt-transport-https && \
    if ls /tmp/certs/*.crt 1> /dev/null 2>&1; then \
        cp /tmp/certs/*.crt /usr/local/share/ca-certificates/ && \
        update-ca-certificates && \
        echo "✓ Corporate certificates installed"; \
    else \
        echo "ℹ No corporate certificates found (optional - only needed for restrictive firewalls)"; \
    fi && \
    rm -rf /tmp/certs && \
    rm -rf /var/lib/apt/lists/*

# Configure Python requests to use system certificates
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Copy requirements first (better layer caching)
COPY requirements-graph.txt .

# Install Python dependencies (no git needed if all packages are on PyPI)
RUN pip install --no-cache-dir -r requirements-graph.txt

# Copy Graph service code and dependencies
COPY service_graph.py .
COPY graph_processor.py .
COPY graph_tasks.py .

# Create temp directory
RUN mkdir -p /app/temp

# Expose port
EXPOSE 8002

# Run the Graph service
CMD ["python", "service_graph.py"]
