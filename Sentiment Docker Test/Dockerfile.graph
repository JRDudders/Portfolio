# Graph Analytics Service - Python 3.12
FROM python:3.12-slim

# Increase pip timeout for slow networks
ENV PIP_DEFAULT_TIMEOUT=200
ENV PIP_RETRIES=5

WORKDIR /app

# Copy certificates directory (may be empty or contain corporate certs like Zscaler)
COPY certs/ /tmp/certs/

# Install corporate certificates BEFORE any other apt-get operations
RUN apt-get update && apt-get install -y ca-certificates apt-transport-https && \
    if ls /tmp/certs/*.crt 1> /dev/null 2>&1; then \
        cp /tmp/certs/*.crt /usr/local/share/ca-certificates/ && \
        update-ca-certificates && \
        echo "✓ Corporate certificates installed"; \
    else \
        echo "ℹ No corporate certificates found (optional - only needed for Zscaler/corporate firewalls)"; \
    fi && \
    rm -rf /tmp/certs && \
    rm -rf /var/lib/apt/lists/*

# Configure Python to use system certificates
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Copy requirements first (better layer caching)
COPY requirements-graph.txt .

# Install PyTorch (CPU version) first to avoid conflicts
# Use >=2.3 for compatibility, let pip find the latest available version for the platform
RUN pip install --no-cache-dir "torch>=2.3" --index-url https://download.pytorch.org/whl/cpu

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-graph.txt

# Copy all required Python files
COPY url_fetch.py .
COPY service_graph.py .
COPY graph_processor.py .
COPY graph_tasks.py .

# Create temp directory
RUN mkdir -p /app/temp

# Expose port
EXPOSE 8002

# Health check
HEALTHCHECK --interval=600s --timeout=10s --start-period=60s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8002/health').raise_for_status()"

# Run the Graph service
CMD ["python", "service_graph.py"]
