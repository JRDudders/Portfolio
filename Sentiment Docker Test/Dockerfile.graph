# Graph Analytics Service - Python 3.12
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements for Graph service
COPY requirements-graph.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-graph.txt

# Copy Graph service code
COPY service_graph.py .
COPY graph_processor.py .

# Create temp directory
RUN mkdir -p /app/temp

# Expose port
EXPOSE 8002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8002/health')"

# Run the Graph service
CMD ["python", "service_graph.py"]
