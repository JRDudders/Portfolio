# Graph Analytics Service - Python 3.12
FROM python:3.12-slim

WORKDIR /app

# Copy requirements first (better layer caching)
COPY requirements-graph.txt .

# Install PyTorch (CPU version) first to avoid conflicts
RUN pip install --no-cache-dir torch>=2.3 --index-url https://download.pytorch.org/whl/cpu

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-graph.txt

# Copy all required Python files
COPY service_graph.py .
COPY graph_processor.py .
COPY graph_tasks.py .

# Create temp directory
RUN mkdir -p /app/temp

# Expose port
EXPOSE 8002

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8002/health')"

# Run the Graph service
CMD ["python", "service_graph.py"]
