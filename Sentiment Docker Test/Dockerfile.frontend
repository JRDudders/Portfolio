# Frontend - Nginx serving static files with reverse proxy
FROM nginx:alpine

# Copy certificates directory FIRST (may be empty or contain corporate certs like Zscaler)
COPY certs/ /tmp/certs/

# Install corporate certificates BEFORE any other operations
RUN apk add --no-cache ca-certificates && \
    if ls /tmp/certs/*.crt 1> /dev/null 2>&1; then \
        cp /tmp/certs/*.crt /usr/local/share/ca-certificates/ && \
        update-ca-certificates && \
        echo "✓ Corporate certificates installed"; \
    else \
        echo "ℹ No corporate certificates found (optional)"; \
    fi && \
    rm -rf /tmp/certs

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy HTML file
COPY index.html /usr/share/nginx/html/index.html

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=600s --timeout=10s \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
