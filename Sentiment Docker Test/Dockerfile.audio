# Audio Deepfake Detection Service - Python 3.10 + fairseq
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies for audio processing
RUN apt-get update && apt-get install -y \
    libsndfile1 \
    ffmpeg \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements for audio service
COPY requirements-audio.txt .

# Install PyTorch (CPU version) first to avoid conflicts
RUN pip install --no-cache-dir torch>=2.3 --index-url https://download.pytorch.org/whl/cpu

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-audio.txt

# Copy audio processing code
COPY audio_antispoofing.py .
COPY audio_service.py .

# Create directories
RUN mkdir -p /app/temp /app/models

# Expose port
EXPOSE 8003

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8003/health')"

# Run the audio service
CMD ["python", "audio_service.py"]
