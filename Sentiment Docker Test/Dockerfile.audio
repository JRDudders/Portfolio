# Audio Deepfake Detection Service - Python 3.10 + fairseq
FROM python:3.10-slim

# Increase pip timeout for slow networks
ENV PIP_DEFAULT_TIMEOUT=200
ENV PIP_RETRIES=5

WORKDIR /app

# Copy certificates directory (may be empty or contain corporate certs like Zscaler)
COPY certs/ /tmp/certs/

# Install corporate certificates BEFORE any other apt-get operations
RUN apt-get update && apt-get install -y ca-certificates apt-transport-https && \
    if ls /tmp/certs/*.crt 1> /dev/null 2>&1; then \
        cp /tmp/certs/*.crt /usr/local/share/ca-certificates/ && \
        update-ca-certificates && \
        echo "✓ Corporate certificates installed"; \
    else \
        echo "ℹ No corporate certificates found (optional - only needed for Zscaler/corporate firewalls)"; \
    fi && \
    rm -rf /tmp/certs && \
    rm -rf /var/lib/apt/lists/*

# Configure Python to use system certificates
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Install system dependencies for audio processing
RUN apt-get update && apt-get install -y \
    libsndfile1 \
    ffmpeg \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements for audio service
COPY requirements-audio.txt .

# Install PyTorch (CPU version) first to avoid conflicts
RUN pip install --no-cache-dir "torch==2.5.1" --index-url https://download.pytorch.org/whl/cpu

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-audio.txt

# Copy audio processing code
COPY url_fetch.py .
COPY audio_antispoofing.py .
COPY audio_service.py .

# Create directories
RUN mkdir -p /app/temp /app/models

# Expose port
EXPOSE 8003

# Health check
HEALTHCHECK --interval=600s --timeout=10s --start-period=60s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8003/health')"

# Run the audio service
CMD ["python", "audio_service.py"]
