# Graph Analytics Service with GPU Support - RAPIDS cuGraph
# Using RAPIDS 24.08a with CUDA 12.5, Python 3.11 (Ubuntu 24.04)
# Note: rapidsai/rapidsai was replaced by rapidsai/base in RAPIDS 23.08+
# CUDA 12.5+ images use Ubuntu 24.04, CUDA 12.2 and below use Ubuntu 22.04
FROM rapidsai/base:24.08a-cuda12.5-py3.11

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CUDA_VISIBLE_DEVICES=0 \
    PIP_DEFAULT_TIMEOUT=200 \
    PIP_RETRIES=5 \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Activate conda environment for all subsequent commands
SHELL ["/bin/bash", "-c"]

WORKDIR /app

# Copy certificates directory (may be empty or contain corporate certs like Zscaler)
COPY certs/ /tmp/certs/

# Install corporate certificates BEFORE any other apt-get operations
RUN apt-get update && apt-get install -y ca-certificates apt-transport-https && \
    if ls /tmp/certs/*.crt 1> /dev/null 2>&1; then \
        cp /tmp/certs/*.crt /usr/local/share/ca-certificates/ && \
        update-ca-certificates && \
        echo "✓ Corporate certificates installed"; \
    else \
        echo "ℹ No corporate certificates found (optional - only needed for Zscaler/corporate firewalls)"; \
    fi && \
    rm -rf /tmp/certs && \
    rm -rf /var/lib/apt/lists/*

# RAPIDS base already has cudf and cugraph installed in the base conda environment
# Install additional dependencies into the base environment
COPY requirements-graph.txt .

# Install PyTorch with GPU support first (CUDA 12.1 compatible with CUDA 12.5 runtime)
# Note: torch is commented out in requirements-graph.txt to avoid conflicts
RUN source /opt/conda/etc/profile.d/conda.sh && \
    conda activate base && \
    pip install --no-cache-dir "torch==2.5.1" --index-url https://download.pytorch.org/whl/cu121

# Install remaining dependencies from requirements file
RUN source /opt/conda/etc/profile.d/conda.sh && \
    conda activate base && \
    pip install --no-cache-dir -r requirements-graph.txt

# Copy all required Python files
COPY url_fetch.py .
COPY service_graph.py .
COPY graph_processor.py .
COPY graph_tasks.py .

# Create temp directory
RUN mkdir -p /app/temp

# Expose port
EXPOSE 8002

# Health check - activate conda environment first
HEALTHCHECK --interval=600s --timeout=10s --start-period=60s --retries=3 \
  CMD bash -c "source /opt/conda/etc/profile.d/conda.sh && conda activate base && python -c \"import requests; requests.get('http://localhost:8002/health').raise_for_status()\""

# Run the Graph service with conda environment activated
CMD ["/bin/bash", "-c", "source /opt/conda/etc/profile.d/conda.sh && conda activate base && python service_graph.py"]
