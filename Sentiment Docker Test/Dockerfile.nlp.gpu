# NLP Service with GPU Support - Python 3.12
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install Python 3.12
RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    python3.12-distutils \
    python3-pip \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.12 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1

# Upgrade pip
RUN python3.12 -m pip install --upgrade pip

# Copy requirements for NLP service
COPY requirements-nlp.txt .

# Install Python dependencies with GPU support
RUN pip install torch --index-url https://download.pytorch.org/whl/cu121 && \
    pip install --no-cache-dir -r requirements-nlp.txt

# Copy NLP service code
COPY service_nlp.py .
COPY nlp_processor.py .

# Create temp directory
RUN mkdir -p /app/temp

# Expose port
EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8001/health || exit 1

# Run the NLP service
CMD ["python", "service_nlp.py"]
