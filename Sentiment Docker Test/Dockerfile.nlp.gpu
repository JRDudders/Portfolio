# NLP Service with GPU Support - Python 3.12
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install Python 3.12 and browser dependencies
RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    python3.12-venv \
    curl \
    wget \
    chromium-browser \
    chromium-chromedriver \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libnss3 \
    libxss1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libnspr4 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Copy certificates directory (may be empty or contain corporate certs)
# Place your corporate .crt files in certs/ directory before building
COPY certs /tmp/certs

# Install any corporate certificates found
RUN if ls /tmp/certs/*.crt 1> /dev/null 2>&1; then \
        cp /tmp/certs/*.crt /usr/local/share/ca-certificates/ && \
        update-ca-certificates && \
        echo "✓ Corporate certificates installed"; \
    else \
        echo "ℹ No corporate certificates found (optional - only needed for restrictive firewalls)"; \
    fi && \
    rm -rf /tmp/certs

# Configure Python requests to use system certificates
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Set Chrome path for Selenium
ENV CHROME_BIN=/usr/bin/chromium-browser
ENV CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Set Python 3.12 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1

# Install pip for Python 3.12 using ensurepip (built into Python 3.12)
RUN python3.12 -m ensurepip --upgrade && \
    python3.12 -m pip install --upgrade pip setuptools wheel

# Copy requirements for NLP service
COPY requirements-nlp.txt .

# Install PyTorch with GPU support (CUDA 12.1)
# Using latest stable version with CUDA support
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

# Install remaining Python dependencies
RUN pip install --no-cache-dir -r requirements-nlp.txt

# Install Playwright browsers (after pip install)
RUN playwright install chromium --with-deps

# Copy all required Python files
COPY url_fetch.py .
COPY service_nlp.py .
COPY nlp_processor.py .
COPY nlp.py .
COPY topics.py .
COPY adapters.py .
COPY fetch.py .
COPY render.py .
COPY apputils.py .

# Create temp directory
RUN mkdir -p /app/temp

# Expose port
EXPOSE 8001

# Health check (every 10 minutes)
HEALTHCHECK --interval=600s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8001/health || exit 1

# Run the NLP service
CMD ["python", "service_nlp.py"]
