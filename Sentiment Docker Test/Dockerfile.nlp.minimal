# syntax=docker/dockerfile:1.7
# NLP Service - Minimal Build for Batch Excel Processing
# Only includes: Sentiment, Zero-shot themes, Translation, Narrative generation
FROM python:3.12-slim

ENV PIP_DEFAULT_TIMEOUT=200
ENV PIP_RETRIES=5

WORKDIR /app

# Copy certificates directory (may be empty or contain corporate certs like Zscaler)
COPY certs/ /tmp/certs/

# Install corporate certificates BEFORE any other apt-get operations
RUN apt-get update && apt-get install -y ca-certificates apt-transport-https && \
    if ls /tmp/certs/*.crt 1> /dev/null 2>&1; then \
        cp /tmp/certs/*.crt /usr/local/share/ca-certificates/ && \
        update-ca-certificates && \
        echo "Corporate certificates installed"; \
    else \
        echo "No corporate certificates found"; \
    fi && \
    rm -rf /tmp/certs && \
    rm -rf /var/lib/apt/lists/*

# Configure Python to use system certificates
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Install system dependencies for Chromium (URL fetching)
RUN apt-get update && apt-get install -y \
    chromium \
    chromium-driver \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libnss3 \
    libxss1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libnspr4 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

ENV CHROME_BIN=/usr/bin/chromium
ENV CHROMEDRIVER_PATH=/usr/bin/chromedriver
# Configure Playwright to use system Chromium instead of downloading
ENV PLAYWRIGHT_BROWSERS_PATH=/usr/bin
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Copy requirements
COPY requirements-nlp.txt .

# Install PyTorch with CUDA support
RUN pip install --no-cache-dir "torch>=2.3" --index-url https://download.pytorch.org/whl/cu121

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-nlp.txt

# Install additional translation dependencies
RUN pip install --no-cache-dir sentencepiece sacremoses

# Skip Playwright browser download - using system Chromium instead
# Verify Playwright can find the system browser
RUN python -c "from playwright.sync_api import sync_playwright; print('Playwright configured to use system Chromium')"

# Copy only required Python files for batch Excel processing
COPY url_fetch.py .
COPY service_nlp.py .
COPY nlp.py .
COPY fetch.py .
COPY adapters.py .
COPY apputils.py .
COPY excel_utils.py .
COPY file_store.py .

# Create temp directory
RUN mkdir -p /app/temp

# HuggingFace settings
ENV HF_HUB_DISABLE_SSL_VERIFY=1
ENV HF_HUB_DISABLE_TELEMETRY=1
ENV HF_HUB_DISABLE_XET=1
ENV HF_HUB_ENABLE_HF_TRANSFER=0

ARG HF_TOKEN=""
ENV HF_TOKEN=${HF_TOKEN}

# Download ONLY the minimal models needed for batch Excel processing
# Uses BuildKit cache mount to speed up rebuilds, then copies to image
ENV HF_HOME=/app/models
COPY download_models.py .
RUN --mount=type=cache,target=/tmp/hf_cache \
    HF_HOME=/tmp/hf_cache python download_models.py

# Copy cached models into the image
RUN --mount=type=cache,target=/tmp/hf_cache \
    mkdir -p /app/models && cp -r /tmp/hf_cache/* /app/models/ 2>/dev/null || true

EXPOSE 8001

HEALTHCHECK --interval=600s --timeout=10s --start-period=60s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:8001/health').raise_for_status()"

CMD ["python", "service_nlp.py"]
