# Environment Variables for CiceroWatch

# HuggingFace Token (required for some models)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Alternative variable name (either works)
# HUGGINGFACE_API_KEY=your_huggingface_token_here

# Batch Processing Settings (optional)
# CLASSIFY_BATCH_SIZE=16
# ZEROSHOT_BATCH_SIZE=8
# STANCE_BATCH_SIZE=32
# CLASSIFY_MAX_WORDS=320

# Server Settings
# PORT=8080
# HOST=0.0.0.0
