# Environment Variables for CiceroWatch

# HuggingFace Token (required for some models)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Alternative variable name (either works)
# HUGGINGFACE_API_KEY=your_huggingface_token_here

# SSL Certificate Handling (for corporate networks or Conda environments)
# Uncomment if you get SSL certificate verification errors
# HF_HUB_DISABLE_SSL_VERIFY=1
# CURL_CA_BUNDLE=
# REQUESTS_CA_BUNDLE=

# Model Selection (for corporate firewalls)
# Default uses smaller DistilBERT model (268MB) for faster downloads
# Set to use larger, more accurate model if firewall allows large downloads
# SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# Batch Processing Settings (optional)
# CLASSIFY_BATCH_SIZE=16
# ZEROSHOT_BATCH_SIZE=8
# STANCE_BATCH_SIZE=32
# CLASSIFY_MAX_WORDS=320

# Server Settings
# PORT=8080
# HOST=0.0.0.0
